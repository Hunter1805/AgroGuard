NODE_ENV=development
PORT=3333
HOST=0.0.0.0

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3333

UPLOAD_PROVIDER=supabase
UPLOAD_PATH=./uploads
LOG_LEVEL=info

SUPABASE_URL=https://your-project.supabase.co
# Placeholder apenas. Obrigatória quando UPLOAD_PROVIDER=supabase ou para Auth Admin.
# Sem fallback para chaves anon. Nunca versionar o valor real.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=agroguard-files
