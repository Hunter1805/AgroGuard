datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. NÚCLEO ORGANIZACIONAL
// ==========================================

model Organization {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  name       String
  status     String    @default("ativo")
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  companies       Company[]
  units           Unit[]
  farms           Farm[]
  equipments      Equipment[]
  workOrders      WorkOrder[]
  stockItems      StockItem[]
  tires           Tire[]
  tools           Tool[]
  auditLogs       AuditLog[]
  legacyMaps      LegacyIdMap[]
  memberships     OrganizationMembership[]
  settings        OrganizationSetting?
  onboardingState OnboardingState?
  invitations     UserInvitation[]

  maintenancePlans          MaintenancePlan[]
  maintenancePlanEquipments MaintenancePlanEquipment[]
  maintenanceSchedules      MaintenanceSchedule[]

  @@map("organizations")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  corporateName  String?
  tradeName      String?
  cnpj           String?
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  units        Unit[]
  farms        Farm[]
  equipments   Equipment[]

  @@unique([organizationId, code])
  @@map("companies")
}

model Unit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  companyId      String   @db.Uuid
  code           String
  name           String
  type           String   @default("matriz")
  city           String?
  state          String?
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  farms        Farm[]
  sectors      Sector[]
  equipments   Equipment[]

  @@unique([organizationId, code])
  @@map("units")
}

model Farm {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  companyId         String   @db.Uuid
  unitId            String   @db.Uuid
  code              String
  name              String
  totalAreaHectares Decimal? @db.Decimal(12, 2)
  status            String   @default("ativo")
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sectors      Sector[]
  equipments   Equipment[]

  @@unique([organizationId, code])
  @@map("farms")
}

model Sector {
  id        String   @id @default(uuid()) @db.Uuid
  unitId    String   @db.Uuid
  farmId    String?  @db.Uuid
  code      String
  name      String
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  unit Unit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  farm Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@map("sectors")
}

model LocationItem {
  id               String   @id @default(uuid()) @db.Uuid
  code             String
  name             String
  type             String   @default("patio")
  parentLocationId String?  @db.Uuid
  status           String   @default("ativo")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  parentLocation LocationItem?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  subLocations   LocationItem[] @relation("LocationHierarchy")

  @@map("locations")
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("cost_centers")
}

model Workshop {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  type      String   @default("interna")
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  workOrders                WorkOrder[]
  maintenancePlanEquipments MaintenancePlanEquipment[]
  maintenanceSchedules      MaintenanceSchedule[]

  @@map("workshops")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  stockBalances StockBalance[]

  @@map("warehouses")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  type      String   @default("mecanica")
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  maintenanceSchedules MaintenanceSchedule[]

  @@map("teams")
}

// ==========================================
// 2. MASTER DATA / TABELAS AUXILIARES
// ==========================================

model EquipmentType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  equipments Equipment[]

  @@map("equipment_types")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  models Model[]

  @@map("brands")
}

model Model {
  id        String   @id @default(uuid()) @db.Uuid
  brandId   String   @db.Uuid
  code      String
  name      String
  powerHp   Int?
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  brand      Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  equipments Equipment[]

  @@map("models")
}

model TechnicalSystem {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  status      String   @default("ativo")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  subsystems TechnicalSubsystem[]

  @@map("technical_systems")
}

model TechnicalSubsystem {
  id        String   @id @default(uuid()) @db.Uuid
  systemId  String   @db.Uuid
  code      String
  name      String
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  system     TechnicalSystem      @relation(fields: [systemId], references: [id], onDelete: Restrict)
  components TechnicalComponent[]

  @@map("technical_subsystems")
}

model TechnicalComponent {
  id          String   @id @default(uuid()) @db.Uuid
  subsystemId String   @db.Uuid
  code        String
  name        String
  status      String   @default("ativo")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  subsystem TechnicalSubsystem @relation(fields: [subsystemId], references: [id], onDelete: Restrict)

  @@map("technical_components")
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  corporateName  String?
  documentNumber String?
  phone          String?
  email          String?
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("suppliers")
}

model UnitMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  symbol    String
  status    String   @default("ativo")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  stockItems StockItem[]

  @@map("unit_measures")
}

// ==========================================
// 3. ADMINISTRAÇÃO E USUÁRIOS
// ==========================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  authUserId   String?   @unique @db.Uuid
  name         String
  email        String    @unique
  phone        String?
  employeeCode String?
  type         String    @default("interno")
  status       String    @default("ativo")
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  userRoles        UserRole[]
  workOrdersOpened WorkOrder[]              @relation("WorkOrderOpener")
  meterReadings    MeterReading[]
  auditLogs        AuditLog[]
  memberships      OrganizationMembership[]
  preferences      UserPreference?

  maintenancePlansCreated              MaintenancePlan[]          @relation("MaintenancePlanCreator")
  maintenancePlanEquipmentsResponsible MaintenancePlanEquipment[]
  maintenanceSchedulesResponsible      MaintenanceSchedule[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  systemRole  Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==========================================
// 4. EQUIPAMENTOS, MEDIDORES E LEITURAS
// ==========================================

model Equipment {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  companyId       String    @db.Uuid
  unitId          String    @db.Uuid
  farmId          String?   @db.Uuid
  equipmentTypeId String    @db.Uuid
  modelId         String    @db.Uuid
  code            String
  name            String
  serialNumber    String?
  manufactureYear Int?
  status          String    @default("operacional")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime? @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  farm          Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)
  model         Model         @relation(fields: [modelId], references: [id], onDelete: Restrict)

  meters               EquipmentMeter[]
  meterReadings        MeterReading[]
  workOrders           WorkOrder[]
  tirePositions        TirePosition[]
  maintenancePlans     MaintenancePlanEquipment[]
  maintenanceSchedules MaintenanceSchedule[]

  @@unique([organizationId, code])
  @@map("equipments")
}

model EquipmentMeter {
  id           String   @id @default(uuid()) @db.Uuid
  equipmentId  String   @db.Uuid
  meterType    String   @default("horimetro")
  currentValue Decimal  @default(0) @db.Decimal(16, 3)
  unit         String   @default("h")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  meterReadings MeterReading[]

  @@map("equipment_meters")
}

model MeterReading {
  id           String   @id @default(uuid()) @db.Uuid
  equipmentId  String   @db.Uuid
  meterId      String   @db.Uuid
  readingValue Decimal  @db.Decimal(16, 3)
  readingDate  DateTime @db.Timestamptz(3)
  readByUserId String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  equipment  Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  meter      EquipmentMeter @relation(fields: [meterId], references: [id], onDelete: Restrict)
  readByUser User?          @relation(fields: [readByUserId], references: [id], onDelete: SetNull)

  @@map("meter_readings")
}

// ==========================================
// 5. ORDENS DE SERVIÇO (WORK ORDERS)
// ==========================================

model WorkOrder {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  workshopId      String?   @db.Uuid
  equipmentId     String    @db.Uuid
  openedByUserId  String?   @db.Uuid
  code            String
  nature          String    @default("MAINTENANCE")
  maintenanceType String?
  correctiveMode  String?
  trigger         String    @default("MANUAL")
  priority        String    @default("NORMAL")
  status          String    @default("aberta")
  description     String
  totalCost       Decimal   @default(0) @db.Decimal(14, 2)
  version         Int       @default(1)
  openedAt        DateTime  @default(now()) @db.Timestamptz(3)
  closedAt        DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workshop     Workshop?    @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  equipment    Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  openedByUser User?        @relation("WorkOrderOpener", fields: [openedByUserId], references: [id], onDelete: SetNull)

  stockMovements StockMovement[]
  schedules      MaintenanceSchedule[]

  @@unique([organizationId, code])
  @@map("work_orders")
}

// ==========================================
// 6. PNEUS E RODADOS
// ==========================================

model Tire {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  serialNumber   String?
  brand          String
  model          String
  size           String
  currentDepthMm Decimal  @default(15.0) @db.Decimal(10, 3)
  status         String   @default("em_estoque")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  positions    TirePosition[]

  @@unique([organizationId, code])
  @@map("tires")
}

model TirePosition {
  id           String   @id @default(uuid()) @db.Uuid
  equipmentId  String   @db.Uuid
  tireId       String   @db.Uuid
  positionCode String
  installedAt  DateTime @default(now()) @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  tire      Tire      @relation(fields: [tireId], references: [id], onDelete: Restrict)

  @@map("tire_positions")
}

// ==========================================
// 7. FERRAMENTAS E KITS
// ==========================================

model Tool {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  name           String
  serialNumber   String?
  status         String   @default("disponivel")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@map("tools")
}

// ==========================================
// 8. ESTOQUE E MATERIAL
// ==========================================

model StockItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  unitMeasureId  String   @db.Uuid
  code           String
  name           String
  partNumber     String?
  minQuantity    Decimal  @default(0) @db.Decimal(16, 3)
  status         String   @default("ativo")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unitMeasure  UnitMeasure     @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  balances     StockBalance[]
  movements    StockMovement[]

  @@unique([organizationId, code])
  @@map("stock_items")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @db.Uuid
  stockItemId String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(16, 3)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, stockItemId])
  @@map("stock_balances")
}

model StockMovement {
  id           String   @id @default(uuid()) @db.Uuid
  stockItemId  String   @db.Uuid
  workOrderId  String?  @db.Uuid
  type         String // entrada, saide, ajuste
  quantity     Decimal  @db.Decimal(16, 3)
  unitCost     Decimal  @default(0) @db.Decimal(14, 2)
  movementDate DateTime @default(now()) @db.Timestamptz(3)

  stockItem StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
}

// ==========================================
// 9. INFRAESTRUTURA, NUMERAÇÃO E AUDITORIA
// ==========================================

model NumberSequence {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @unique
  prefix      String
  nextValue   Int      @default(1)
  digitsCount Int      @default(5)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("number_sequences")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  actorName      String?
  module         String
  entityType     String
  entityId       String
  action         String
  previousData   Json?
  newData        Json?
  reason         String?
  requestId      String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model LegacyIdMap {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  module         String
  entityType     String
  legacyId       String
  newUuid        String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([module, legacyId])
  @@map("legacy_id_maps")
}

// ==========================================
// 10. MULTIEMPRESA, ONBOARDING E CONVITES
// ==========================================

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @default("membro") // proprietario, administrador, tecnico, operador
  status         String   @default("ativo") // ativo, pendente, inativo, bloqueado
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope        OrganizationScope?

  @@unique([organizationId, userId])
  @@map("organization_memberships")
}

model OrganizationScope {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @unique @db.Uuid
  allCompanies Boolean  @default(true)
  allUnits     Boolean  @default(true)
  allFarms     Boolean  @default(true)
  companyIds   Json? // Array de UUIDs de empresas permitidas ex: ["uuid-1"]
  unitIds      Json? // Array de UUIDs de unidades permitidas
  farmIds      Json? // Array de UUIDs de fazendas permitidas
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("organization_scopes")
}

model UserPreference {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  theme         String   @default("light")
  homeRoute     String   @default("/app/dashboard")
  tableDensity  String   @default("comfortable")
  dateFormat    String   @default("dd/MM/yyyy")
  timeFormat    String   @default("24h")
  notifications Json // Estrutura de flags de notificação
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model OrganizationSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  timezone       String   @default("America/Sao_Paulo")
  language       String   @default("pt-BR")
  currency       String   @default("BRL")
  features       Json? // Flags de features habilitadas
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OnboardingState {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  currentStep    Int      @default(0) // 0 de 4 etapas
  stepsCompleted Json // Objeto indicando status, ex: {"step1": false, "step2": false, "step3": false, "step4": false}
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

model UserInvitation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String
  role           String   @default("tecnico")
  scope          Json // Escopo organizacional a ser associado
  token          String   @unique
  status         String   @default("pendente") // pendente, aceito, expirado, cancelado
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("user_invitations")
}

// ==========================================
// 11. SISTEMA DE MANUTENÇÃO (PLANOS E AGENDA)
// ==========================================

enum MaintenanceScheduleStatus {
  SCHEDULED
  DUE
  OVERDUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  CONDITION_BASED
  ROUTINE_INSPECTION
}

enum MaintenanceTrigger {
  SCHEDULE
  CALENDAR
  HOUR_METER
  ODOMETER
  CYCLE
  CHECKLIST
  INSPECTION
  FAILURE
  SENSOR
  ALERT
  OPERATOR_REPORT
  MANUAL
}

model MaintenancePlan {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  code            String?
  name            String
  description     String?
  version         Int      @default(1)
  active          Boolean  @default(true)
  archived        Boolean  @default(false)
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser User?                      @relation("MaintenancePlanCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  intervals     MaintenancePlanInterval[]
  equipments    MaintenancePlanEquipment[]
  schedules     MaintenanceSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("maintenance_plans")
}

model MaintenancePlanInterval {
  id                       String             @id @default(uuid()) @db.Uuid
  maintenancePlanId        String             @db.Uuid
  name                     String
  description              String?
  triggerType              MaintenanceTrigger
  rule                     String?
  meterType                String?
  readingInterval          Decimal?           @db.Decimal(16, 3)
  timeInterval             Int?
  timeUnit                 String?
  alertReadingBefore       Decimal?           @db.Decimal(16, 3)
  alertDaysBefore          Int?
  allowedReadingDelay      Decimal?           @db.Decimal(16, 3)
  allowedDaysDelay         Int?
  priority                 String             @default("NORMAL")
  estimatedDurationMinutes Int?
  requiresEquipmentStop    Boolean            @default(false)
  requiresApproval         Boolean            @default(false)
  tasks                    Json?

  plan      MaintenancePlan       @relation(fields: [maintenancePlanId], references: [id], onDelete: Cascade)
  schedules MaintenanceSchedule[]

  @@index([maintenancePlanId])
  @@map("maintenance_plan_intervals")
}

model MaintenancePlanEquipment {
  id                          String    @id @default(uuid()) @db.Uuid
  organizationId              String    @db.Uuid
  equipmentId                 String    @db.Uuid
  maintenancePlanId           String    @db.Uuid
  startDate                   DateTime  @db.Timestamptz(3)
  baseReading                 Decimal?  @db.Decimal(16, 3)
  baseDate                    DateTime? @db.Timestamptz(3)
  lastKnownMaintenanceDate    DateTime? @db.Timestamptz(3)
  lastKnownMaintenanceReading Decimal?  @db.Decimal(16, 3)
  active                      Boolean   @default(true)
  maintenanceResponsibleId    String?   @db.Uuid
  workshopId                  String?   @db.Uuid
  observations                String?
  createdAt                   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime  @updatedAt @db.Timestamptz(3)

  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment              Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenancePlan        MaintenancePlan @relation(fields: [maintenancePlanId], references: [id], onDelete: Cascade)
  maintenanceResponsible User?           @relation(fields: [maintenanceResponsibleId], references: [id], onDelete: SetNull)
  workshop               Workshop?       @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@unique([equipmentId, maintenancePlanId])
  @@index([organizationId])
  @@index([equipmentId])
  @@index([maintenancePlanId])
  @@map("maintenance_plan_equipments")
}

model MaintenanceSchedule {
  id                        String                    @id @default(uuid()) @db.Uuid
  code                      String
  organizationId            String                    @db.Uuid
  equipmentId               String                    @db.Uuid
  maintenancePlanId         String?                   @db.Uuid
  maintenancePlanIntervalId String?                   @db.Uuid
  scheduledDate             DateTime                  @db.Timestamptz(3)
  dueReading                Decimal?                  @db.Decimal(16, 3)
  meterType                 String?
  currentReading            Decimal?                  @db.Decimal(16, 3)
  priority                  String                    @default("NORMAL")
  status                    MaintenanceScheduleStatus
  responsibleId             String?                   @db.Uuid
  teamId                    String?                   @db.Uuid
  workshopId                String?                   @db.Uuid
  estimatedDurationMinutes  Int                       @default(0)
  requiresEquipmentStop     Boolean                   @default(false)
  observations              String?
  rescheduleReason          String?
  canceledReason            String?
  workOrderId               String?                   @db.Uuid
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(3)
  completedAt               DateTime?                 @db.Timestamptz(3)
  triggerType               MaintenanceTrigger?
  maintenanceType           MaintenanceType?
  tasks                     Json?
  parts                     Json?
  supplies                  Json?
  tools                     Json?

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment               Equipment                @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  maintenancePlan         MaintenancePlan?         @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull)
  maintenancePlanInterval MaintenancePlanInterval? @relation(fields: [maintenancePlanIntervalId], references: [id], onDelete: SetNull)
  responsible             User?                    @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  team                    Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  workshop                Workshop?                @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  workOrder               WorkOrder?               @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([equipmentId])
  @@index([scheduledDate])
  @@index([status])
  @@map("maintenance_schedules")
}
