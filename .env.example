NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# String de Conexão Postgres (Supabase ou Local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/agroguard_db?schema=public"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/agroguard_db"

CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3333

# Provedor de Armazenamento de Arquivos (local | supabase)
UPLOAD_PROVIDER=supabase
UPLOAD_PATH=./uploads

# Credenciais do Supabase Storage (somente no servidor backend)
# Fase 17S: SUPABASE_SERVICE_ROLE_KEY é obrigatória apenas quando UPLOAD_PROVIDER=supabase
# ou quando operações administrativas (Auth Admin) são usadas. Nunca há fallback para
# chaves anon e nenhum valor real deve ser versionado aqui — apenas placeholders.
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-sua-service-role-key
SUPABASE_STORAGE_BUCKET=agroguard-files
LOG_LEVEL=info
# Frontend — API pública de produção
VITE_API_BASE_URL=https://agroguard-4tve.onrender.com/api/v1
# Frontend — Supabase (chave anon é pública por design; service_role NUNCA aqui)
VITE_SUPABASE_URL=https://sua-instancia.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-aqui-sua-anon-key
